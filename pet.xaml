<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="白龙娘 · Codex" Width="304" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Grid x:Name="Root" Background="Transparent" TextElement.FontFamily="Microsoft YaHei UI" TextElement.FontSize="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border x:Name="Card" Margin="6,8,6,0" Padding="14,12" CornerRadius="18" Background="#F5232230" BorderBrush="#756D628C" BorderThickness="1" VerticalAlignment="Top">
   <StackPanel>
    <DockPanel Margin="0,0,0,10">
     <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#B8A8E8" Margin="0,0,7,0"/>
     <TextBlock x:Name="Heading" Text="白龙娘 · 稍等一下" Foreground="#EDE7FC" FontSize="14" FontWeight="SemiBold"/>
    </DockPanel>
    <StackPanel x:Name="IdlePanel">
     <DockPanel><TextBlock x:Name="QuotaLabel" Text="5 小时额度" Foreground="#BDB8CB" FontSize="14"/><TextBlock x:Name="Quota" Text="读取中…" Foreground="#F9F6FF" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right"/></DockPanel>
     <TextBlock x:Name="PrimaryReset" Text="刷新：--" Foreground="#BDB8CB" FontSize="14" Margin="0,2,0,0"/>
     <ProgressBar x:Name="QuotaBar" Height="3" Maximum="100" Value="0" Foreground="#B5A3EB" Background="#504A61" BorderThickness="0" Margin="0,6,0,8"/>
     <DockPanel><TextBlock x:Name="WeeklyLabel" Text="每周额度" Foreground="#BDB8CB" FontSize="14"/><TextBlock x:Name="WeeklyQuota" Text="读取中…" Foreground="#F9F6FF" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right"/></DockPanel>
     <TextBlock x:Name="SecondaryReset" Text="刷新：--" Foreground="#BDB8CB" FontSize="14" Margin="0,2,0,0"/>
     <ProgressBar x:Name="WeeklyBar" Height="3" Maximum="100" Value="0" Foreground="#B5A3EB" Background="#504A61" BorderThickness="0" Margin="0,6,0,9"/>
     <DockPanel><TextBlock Text="今日 token" Foreground="#BDB8CB" FontSize="14"/><TextBlock x:Name="Tokens" Text="统计中…" Foreground="#F9F6FF" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right"/></DockPanel>
     <TextBlock x:Name="PlanExpiry" Text="套餐到期（手动）：未设置" Foreground="#BDB8CB" Margin="0,9,0,0"/>
     <TextBlock x:Name="PlanRemaining" Text="套餐剩余：--" Foreground="#BDB8CB" Margin="0,2,0,0"/>
     <DockPanel Margin="0,4,0,0"><TextBlock x:Name="ResetCreditLabel" Text="重置卡" Foreground="#BDB8CB"/><TextBlock x:Name="ResetCredits" Text="--" Foreground="#F9F6FF" FontWeight="SemiBold" HorizontalAlignment="Right"/></DockPanel>
     <TextBlock x:Name="Footnote" Text="本机 · 北京时间" Foreground="#A29AAF" FontSize="14" Margin="0,5,0,0"/>
    </StackPanel>
    <StackPanel x:Name="BusyPanel" Visibility="Collapsed">
     <TextBlock x:Name="TaskTitle" Text="Codex 任务" Foreground="#F8F5FF" FontSize="16" TextWrapping="Wrap" MaxHeight="66" TextTrimming="CharacterEllipsis"/>
     <TextBlock x:Name="Activity" Text="正在工作…" Foreground="#BEB4D7" FontSize="14" Margin="0,12,0,0" TextWrapping="Wrap"/>
     <TextBlock x:Name="TaskNote" Text="完成后会显示用量" Foreground="#A29AAF" FontSize="14" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </StackPanel>
   </StackPanel>
  </Border>
  <Image x:Name="Dragon" Grid.Row="1" Width="127.2" Height="176.4" Stretch="Uniform" VerticalAlignment="Top" Margin="0,5,0,5" RenderTransformOrigin="0.5,1" RenderOptions.BitmapScalingMode="HighQuality">
   <Image.RenderTransform><TransformGroup><ScaleTransform x:Name="Breath"/><TranslateTransform x:Name="Float"/></TransformGroup></Image.RenderTransform>
  </Image>
 </Grid>
</Window>
